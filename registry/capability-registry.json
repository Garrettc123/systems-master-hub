  "templates": {
    "health_endpoint": {
      "description": "FastAPI /health route returning system status, version, uptime",
      "scaffold": "from fastapi import FastAPI\nfrom datetime import datetime\nimport time\n\nSTART_TIME = time.time()\n\n@app.get('/health')\nasync def health():\n    return {\"status\": \"healthy\", \"system\": SYSTEM_ID, \"uptime_seconds\": int(time.time() - START_TIME), \"timestamp\": datetime.utcnow().isoformat()}"
    },
    "metrics_endpoint": {
      "description": "Prometheus-compatible /metrics route",
      "scaffold": "from prometheus_client import generate_latest, CONTENT_TYPE_LATEST, Counter, Gauge\nfrom fastapi.responses import Response\n\nREQUEST_COUNT = Counter('garcar_requests_total', 'Total requests', ['system', 'endpoint'])\nREVENUE_EVENTS = Counter('garcar_revenue_events_total', 'Revenue events', ['system', 'type'])\nMATURITY_GAUGE = Gauge('garcar_maturity_score', 'Maturity score', ['system'])\n\n@app.get('/metrics')\nasync def metrics():\n    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)"
    },
    "webhook_receiver": {
      "description": "HMAC-validated webhook receiver that routes to event bus",
      "scaffold": "import hmac, hashlib\nfrom fastapi import Request, HTTPException\n\n@app.post('/webhook')\nasync def receive_webhook(request: Request):\n    body = await request.body()\n    sig = request.headers.get('X-Garcar-Signature', '')\n    expected = hmac.new(WEBHOOK_SECRET.encode(), body, hashlib.sha256).hexdigest()\n    if not hmac.compare_digest(sig, f'sha256={expected}'):\n        raise HTTPException(status_code=401)\n    payload = await request.json()\n    await event_bus.emit(f'garcar.{SYSTEM_ID}.webhook.received', payload)\n    return {\"received\": True}"
    },
    "stripe_billing_hook": {
      "description": "Stripe webhook — emits revenue signals on payment events",
      "scaffold": "import stripe\n\n@app.post('/stripe/webhook')\nasync def stripe_webhook(request: Request):\n    payload = await request.body()\n    sig = request.headers.get('stripe-signature')\n    try:\n        event = stripe.Webhook.construct_event(payload, sig, STRIPE_WEBHOOK_SECRET)\n    except Exception:\n        raise HTTPException(status_code=400)\n    if event.type in ['payment_intent.succeeded', 'invoice.payment_succeeded', 'customer.subscription.created']:\n        await event_bus.emit(f'garcar.{SYSTEM_ID}.revenue.signal', {\"amount\": event.data.object.get('amount_received', 0), \"attribution\": ATTRIBUTION_CODE, \"stripe_event\": event.type})\n    return {\"status\": \"processed\"}"
    },
    "event_bus_connected": {
      "description": "Redis Streams event bus — publish and consume garcar.* events",
      "scaffold": "import redis.asyncio as redis\nimport json\n\nclass GarcarEventBus:\n    def __init__(self):\n        self.redis = redis.from_url(REDIS_URL)\n    async def emit(self, event_type: str, payload: dict):\n        await self.redis.xadd('garcar:events', {\"type\": event_type, \"payload\": json.dumps(payload), \"system\": SYSTEM_ID})\n    async def consume(self, prefix: str, handler):\n        while True:\n            msgs = await self.redis.xread({'garcar:events': '$'}, block=1000)\n            for _, entries in msgs:\n                for _, fields in entries:\n                    if fields[b'type'].decode().startswith(prefix):\n                        await handler(json.loads(fields[b'payload']))\n\nevent_bus = GarcarEventBus()"
    },
    "revenue_signal_emitter": {
      "description": "Emits revenue signal to RHNS whenever this system produces value",
      "scaffold": "async def emit_revenue_signal(amount_usd: float, source: str, metadata: dict = {}):\n    await event_bus.emit('garcar.revenue.signal', {\"amount_usd\": amount_usd, \"source\": source, \"system\": SYSTEM_ID, \"attribution_code\": ATTRIBUTION_CODE, \"metadata\": metadata})\n    await http_client.post(RHNS_URL + '/signals', json={\"system\": SYSTEM_ID, \"amount\": amount_usd, \"source\": source})"
    },
    "atlas_dashboard_feed": {
      "description": "Pushes real-time status and revenue data to ATLAS dashboard",
      "scaffold": "async def push_to_atlas():\n    await http_client.post(ATLAS_URL + '/api/systems/update', json={\"system_id\": SYSTEM_ID, \"health\": \"healthy\", \"maturity_score\": MATURITY_SCORE, \"revenue_mtd\": await get_revenue_mtd(), \"last_event\": datetime.utcnow().isoformat(), \"capabilities\": CAPABILITIES})"
    },
    "self_healing": {
      "description": "Auto-restart on failure with exponential backoff and alerting",
      "scaffold": "import asyncio, logging\n\nasync def self_heal(task_fn, max_retries=5, base_delay=2):\n    for attempt in range(max_retries):\n        try:\n            return await task_fn()\n        except Exception as e:\n            delay = base_delay ** attempt\n            logging.error(f'[{SYSTEM_ID}] Attempt {attempt+1} failed: {e}. Retrying in {delay}s...')\n            await event_bus.emit(f'garcar.{SYSTEM_ID}.self_heal.retry', {\"attempt\": attempt+1, \"error\": str(e)})\n            await asyncio.sleep(delay)\n    await event_bus.emit(f'garcar.{SYSTEM_ID}.self_heal.exhausted', {\"system\": SYSTEM_ID})"
    },
    "audit_log_emission": {
      "description": "Emits tamper-proof audit entries to garcar-audit-trail QLDB",
      "scaffold": "async def emit_audit(action: str, actor: str, resource: str, metadata: dict = {}):\n    entry = {\"system\": SYSTEM_ID, \"action\": action, \"actor\": actor, \"resource\": resource, \"timestamp\": datetime.utcnow().isoformat(), \"metadata\": metadata}\n    await event_bus.emit('garcar.audit.entry', entry)\n    await http_client.post(AUDIT_TRAIL_URL + '/log', json=entry)"
    },
    "drift_detection": {
      "description": "Detects configuration drift vs expected state and alerts",
      "scaffold": "import hashlib, json\n\nEXPECTED_CONFIG_HASH = None\n\nasync def check_drift():\n    current = json.dumps(get_current_config(), sort_keys=True)\n    current_hash = hashlib.sha256(current.encode()).hexdigest()\n    if EXPECTED_CONFIG_HASH and current_hash != EXPECTED_CONFIG_HASH:\n        await event_bus.emit(f'garcar.{SYSTEM_ID}.drift.detected', {\"expected\": EXPECTED_CONFIG_HASH, \"actual\": current_hash})\n        return True\n    return False"
    }
  },

