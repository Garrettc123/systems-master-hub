# ===========================================================================
# GARCAR ENTERPRISE — .gitignore
# ===========================================================================

# VAULT — NEVER COMMIT
vault/.vault.env
vault/*.env
!vault/.vault.env.template
vault/rotation-log.txt

# Environment files
.env
.env.local
.env.*.local
.env.production
.env.staging
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Editor
.vscode/
.idea/
*.sublime-project

# Logs
logs/
*.log

# Temp
tmp/
.tmp/
