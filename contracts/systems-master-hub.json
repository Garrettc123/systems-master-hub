{
  "$schema": "../schema/deploy-contract.schema.json",
  "repo": "Garrettc123/systems-master-hub",
  "name": "systems-master-hub",
  "tier": 1,
  "role": "control-plane",
  "description": "Garcar Enterprise control plane. Owns registry, schema, orchestration workflows, sweep ledger, and canonical secrets spec.",
  "platform": "github-actions",
  "runtime": "node",
  "entrypoint": "orchestrator/garcar-sweep.sh",
  "health": {
    "type": "workflow",
    "successSignals": [
      "contract-validation",
      "dispatch-complete",
      "ledger-written"
    ]
  },
  "integrations": [
    "GitHub",
    "Linear",
    "Slack",
    "Registry",
    "Vault"
  ],
  "requiredSecrets": [
    "GITHUB_TOKEN",
    "LINEAR_API_KEY",
    "SLACK_WEBHOOK_URL"
  ],
  "dispatches": [
    "garcar-payments",
    "garcar-payment-loop",
    "TITAN-Autonomous-Business-Empire",
    "enterprise-mlops-platform",
    "atlas-dashboard",
    "zeus-dashboard",
    "mars-api",
    "neural-mesh"
  ],
  "ledger": {
    "mode": "github-issue",
    "repo": "Garrettc123/systems-master-hub",
    "label": "garcar-sweep"
  },
  "sweepSchedule": "0 */6 * * *",
  "registryPath": "registry/repos.json",
  "schemaPath": "schema/deploy-contract.schema.json",
  "secretsSpec": "docs/SECRETSAPI.md",
  "environments": {
    "production": {
      "branch": "main",
      "baseUrl": "https://github.com/Garrettc123/systems-master-hub"
    }
  },
  "meta": {
    "owner": "Garrettc123",
    "created": "2026-06-09",
    "lastUpdated": "2026-06-09"
  }
}
