# ===========================================================================
# GARCAR ENTERPRISE — VAULT TEMPLATE
# AutoKey System v1.0.0 | systems-master-hub
# ===========================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp vault/.vault.env.template vault/.vault.env
#   2. Fill in ALL values below (no blanks in production)
#   3. Run: bash vault/vault-setup.sh
#   4. NEVER commit .vault.env — it is in .gitignore
#   5. For Stripe keys: get from https://dashboard.stripe.com/apikeys
#   6. For Railway token: get from https://railway.app/account/tokens
#   7. For Supabase keys: get from Supabase Dashboard > Settings > API
# ===========================================================================

# ---------------------------------------------------------------------------
# ORCHESTRATION PLANE
# Used by: systems-master-hub, neural-mesh
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
LINEAR_API_KEY=
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# PAYMENT RUNTIME PLANE
# Used by: garcar-payments, garcar-payment-loop
# STRIPE_SECRET_KEY: sk_live_... or sk_test_...
# STRIPE_PUBLISHABLE_KEY: pk_live_... or pk_test_...
# STRIPE_WEBHOOK_SECRET: whsec_...
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SHARED APP PLANE
# Used by: all stateful repos
# SUPABASE_URL: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY: service_role key (NOT anon key — bypasses RLS)
# APP_URL: https://garcar-payments.up.railway.app (production base URL)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
APP_URL=

# ---------------------------------------------------------------------------
# DEPLOY PLATFORM PLANE
# Used by: all CI/CD workflows
# ---------------------------------------------------------------------------
RAILWAY_TOKEN=
VERCEL_TOKEN=
RENDER_API_KEY=

# ---------------------------------------------------------------------------
# AUTOKEY ROTATION TRACKING
# These are auto-populated by rotate-secrets.sh — do not set manually
# ---------------------------------------------------------------------------
# AUTOKEY_LAST_ROTATION=
# AUTOKEY_ROTATION_COUNT=
