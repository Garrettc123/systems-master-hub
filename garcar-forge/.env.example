# Copy to .env locally. Never commit .env.
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'
GARCAR_OPERATOR_TOKEN=REPLACE_WITH_A_64_CHARACTER_RANDOM_SECRET
GARCAR_WORKER_POLL_SECONDS=3
GARCAR_WORKER_LEASE_SECONDS=300
GARCAR_SCHEDULER_ENABLED=false
GARCAR_SCHEDULER_INTERVAL_SECONDS=300
