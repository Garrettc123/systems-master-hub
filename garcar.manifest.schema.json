{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://garcar.internal/schemas/garcar.manifest.schema.json",
  "title": "Garcar System Manifest",
  "type": "object",
  "required": ["system_id", "display_name", "layer", "version", "tier", "capabilities", "apis", "events_published", "events_consumed", "health_endpoints", "dependencies", "owners"],
  "properties": {
    "system_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique kebab-case identifier for the system"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable system name"
    },
    "layer": {
      "type": "string",
      "enum": ["revenue", "intelligence", "infrastructure", "data", "compliance", "interface"],
      "description": "Architectural layer in the Continuum Grid"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (major.minor.patch)"
    },
    "tier": {
      "type": "string",
      "enum": ["prototype", "production", "intelligent", "autonomous"],
      "description": "Maturity tier determining autonomy level"
    },
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Capability tags for routing and discovery"
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "endpoint", "protocol"],
        "properties": {
          "name": {"type": "string"},
          "endpoint": {"type": "string", "format": "uri"},
          "protocol": {"type": "string", "enum": ["http", "grpc", "ws", "mcp"]}
        }
      },
      "description": "Exposed API endpoints"
    },
    "events_published": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Event types this system publishes to the event bus"
    },
    "events_consumed": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Event types this system consumes from the event bus"
    },
    "health_endpoints": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "description": "Health/readiness check URLs"
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "System IDs this system depends on"
    },
    "owners": {
      "type": "array",
      "items": {"type": "string"},
      "description": "GitHub usernames responsible for this system"
    }
  },
  "additionalProperties": false
}
