# Pixel 10 Source Gateway — Cloud Relay Configuration
#
# Copy this file to ~/edge-node/config/relay.env on the Pixel and fill in values.
# These are the ONLY credentials the phone needs — a single relay URL and
# an HMAC key for signing outbound events. All platform-specific secrets
# stay in the cloud (GitHub Secrets, VPS env, etc.).

# Cloud relay endpoint that accepts outbound events from the edge node.
# This is a single webhook URL — the relay routes events to the right
# destination based on the "source" field in the envelope.
CLOUD_RELAY_URL=https://your-relay-server.example.com/api/v1/ingest

# HMAC key for signing outbound events (shared secret with the relay).
# Generate with: openssl rand -hex 32
RELAY_HMAC_KEY=

# Optional: override the node identity (defaults to pixel10-edge)
# NODE_ID=pixel10-edge
